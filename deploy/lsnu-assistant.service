[Unit]
Description=LSNU outbound teaching assistant
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/lsnu-outbound-assistant
EnvironmentFile=/opt/lsnu-outbound-assistant/.env
ExecStart=/opt/lsnu-outbound-assistant/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
